# =============================================================================
# GARSAME v3 — environment
# -----------------------------------------------------------------------------
# Copy to .env.local and fill in. .env.local is git-ignored and must never be
# committed. Every variable the project needs is listed here, including the
# ones that later phases introduce, so nothing is discovered late.
#
#   cp .env.example .env.local
# =============================================================================

# --- Site --------------------------------------------------------------------
# The public origin, no trailing slash. Used for canonical URLs, sitemap.xml,
# Open Graph tags and the unsubscribe links in emails.
# [YOUR DOMAIN] — needed from Phase 4 onward.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# --- Database (Phase 0) ------------------------------------------------------
# Local:      mongodb://127.0.0.1:27017/garsame
# Atlas/VPS:  mongodb+srv://USER:PASSWORD@HOST/garsame?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/garsame


# --- Auth (Phase 5) ----------------------------------------------------------
# Generate a secret with:  openssl rand -base64 32
AUTH_SECRET=
# Auth.js v5 names. In production set AUTH_URL to the public origin and keep
# AUTH_TRUST_HOST=true: the app sits behind Nginx, which is what terminates
# HTTPS and forwards the host.
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# The one admin account, created by `npm run db:seed`. There is no public
# sign-up and no second role — a second account cannot be created. The password
# must be at least 12 characters. To change it later, set a new ADMIN_PASSWORD
# and run `npm run db:seed -- --reset-admin-password`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Garsame Mohamud


# --- Email (Phase 10) --------------------------------------------------------
# Nodemailer over SMTP. Every send is written to the maillogs collection —
# CLAUDE.md rule 5, no silent sends. These seed the settings document; after
# that they are editable in Settings, where there is also a test-send button.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Garsame Mohamud
SMTP_FROM_EMAIL=

# Where contact-form and new-testimonial notifications are sent.
NOTIFY_EMAIL=

# Encrypts the SMTP password at rest in the settings document.
# Generate with:  openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=


# --- Uploads (Phase 6 images, Phase 9 everything else) ----------------------
# Where uploaded images and documents are written on the VPS. Outside public/
# and outside the build output, so a deploy does not wipe it; the app serves
# it at /uploads (app/uploads/[file]/route.ts). D-072.
UPLOAD_DIR=./uploads
# 10MB per file, in bytes.
MAX_UPLOAD_BYTES=10485760


# --- Rate limiting (Phase 10) ------------------------------------------------
# Public forms only: contact, membership, testimonials.
RATE_LIMIT_WINDOW_SECONDS=3600
RATE_LIMIT_MAX_REQUESTS=5
# Minimum seconds between form render and submit, to catch bots.
FORM_MIN_SECONDS=3


# --- Broadcasts (Phase 11) ---------------------------------------------------
# Sending is queued and throttled so the SMTP provider does not reject a batch.
BROADCAST_BATCH_SIZE=25
BROADCAST_BATCH_DELAY_MS=2000


# --- Stats (Phase 12) --------------------------------------------------------
# First-party page-view counting. No third-party script, no cookie banner.
# Set to false to stop recording views entirely.
ANALYTICS_ENABLED=true
# Protects the nightly aggregation endpoint from being called by anyone.
# Generate with:  openssl rand -base64 32
CRON_SECRET=
